PORT=5000
NODE_ENV=development

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Keep secret! Found in Dashboard -> Project Settings -> API)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Anon Key (Public client key)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Frontend Application Origin
FRONTEND_URL=http://localhost:5173
